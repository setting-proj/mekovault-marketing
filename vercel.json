{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "next build",
  "installCommand": "npm install",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/app", "destination": "https://app.mekovault.com", "permanent": false },
    { "source": "/login", "destination": "https://app.mekovault.com/login", "permanent": false },
    { "source": "/signup", "destination": "https://app.mekovault.com/signup", "permanent": false },
    { "source": "/precios", "destination": "/pricing", "permanent": true },
    { "source": "/plataformas", "destination": "/platforms", "permanent": true },
    { "source": "/control-de-licencias", "destination": "/license-control", "permanent": true },
    { "source": "/gobierno-de-cuentas", "destination": "/account-governance", "permanent": true },
    { "source": "/producto", "destination": "/products", "permanent": true },
    { "source": "/nosotros", "destination": "/about", "permanent": true },
    { "source": "/contacto", "destination": "/contact", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/((?!_next|api).*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, s-maxage=3600, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/(llms.txt|llms-full.txt)",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    }
  ]
}
